# ---------- Server ----------
PORT=5000
NODE_ENV=production
# Comma-separated list of allowed browser origins on your LAN.
# Example: http://localhost:5173,http://192.168.1.20:5173
CORS_ORIGINS=http://localhost:5173

# ---------- MySQL (XAMPP defaults) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=caresphere_db

# ---------- Security ----------
# Run `npm run gen-keys` and paste the output here. Never reuse these values.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# 32-byte keys as 64 hex characters (AES-256-GCM)
PHI_ENCRYPTION_KEY=
QR_ENCRYPTION_KEY=
RECEIPT_SIGNING_KEY=
BCRYPT_ROUNDS=12

# ---------- Online donations (PayMongo) ----------
# Test keys (sk_test_...) run in demo mode: no real money is charged. Never put these in the frontend.
PAYMONGO_SECRET_KEY=
# Returned when you register the webhook (whsk_...). The webhook URL must be public HTTPS, for
# example a tunnel to http://localhost:5000/api/payments/webhook
PAYMONGO_WEBHOOK_SECRET=
# Where PayMongo sends donors back after paying (the address donors open CareSphere with).
PUBLIC_APP_URL=http://localhost:5173

# Optional: ClamAV program for scanning uploads (e.g. C:\Program Files\ClamAV\clamdscan.exe). Leave empty if ClamAV is not installed.
CLAMSCAN_PATH=

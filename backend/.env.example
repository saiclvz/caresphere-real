# ---------- Server ----------
PORT=5000
NODE_ENV=production
# Comma-separated list of allowed browser origins on your LAN.
# Example: http://localhost:5173,http://192.168.1.20:5173
CORS_ORIGINS=http://localhost:5173

# ---------- MySQL (XAMPP defaults) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=caresphere_db

# ---------- Security ----------
# Run `npm run gen-keys` and paste the output here. Never reuse these values.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# 32-byte keys as 64 hex characters (AES-256-GCM)
PHI_ENCRYPTION_KEY=
QR_ENCRYPTION_KEY=
RECEIPT_SIGNING_KEY=
BCRYPT_ROUNDS=12

# ---------- Session cookies ----------
# Set to true when CareSphere is opened over HTTPS (the session cookie is then sent only over HTTPS).
# Plain-HTTP LAN installs leave it false; the cookie is still HttpOnly and SameSite=Strict.
COOKIE_SECURE=false
# Optional separate key for short-lived file links (64 hex characters). Without it, a key is derived from JWT_SECRET.
FILE_LINK_KEY=

# Optional: ClamAV program for scanning uploads (e.g. C:\Program Files\ClamAV\clamdscan.exe). Leave empty if ClamAV is not installed.
CLAMSCAN_PATH=

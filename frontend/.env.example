# Leave empty to use the Vite dev proxy (/api -> http://localhost:5000).
# Set only if the API runs on a different host and you are not using the proxy.
VITE_API_URL=

# Address encoded in printed QR codes (adoption submission slips and staff QR cards).
# Phones scan these with their normal camera app, so this must be the server's LAN IP
# or real domain, never localhost (a phone can't open "localhost").
# Example: VITE_PUBLIC_BASE_URL=http://192.168.1.20:5173
# Empty = use the address currently in the browser bar.
VITE_PUBLIC_BASE_URL=
